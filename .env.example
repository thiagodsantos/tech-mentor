# Modelo para `make setup` copiar para .env. Preencha somente a cópia local; não versione segredos.

# Banco PostgreSQL usado pelo Docker Compose
POSTGRES_DB=tech_mentor
POSTGRES_USER=tech_mentor
POSTGRES_PASSWORD=replace-on-first-run

# Criptografia e credenciais OpenRouter
FERNET_KEY=
# Opcional: alternativa a cadastrar a chave pela interface local.
OPENROUTER_API_KEY=

# Intervalos de atualização e cache do catálogo OpenRouter (segundos)
CREDITS_POLL_INTERVAL_SECONDS=300
MINIMUM_CREDITS_POLL_INTERVAL_SECONDS=60
MODELS_CACHE_TTL_SECONDS=300

# Origens permitidas para chamadas do navegador
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opcionais: habilitam webhooks do Batch API (requer URL pública HTTPS)
OPENROUTER_BATCH_CALLBACK_URL=https://<public-api-host>/api/openrouter/batch-webhook
OPENROUTER_WEBHOOK_SECRET=<OpenRouter workspace webhook signing secret>
