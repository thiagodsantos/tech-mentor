# Local development uses SQLite when DATABASE_URL is omitted.
# Production example: postgresql+asyncpg://tech_mentor:change-me@db:5432/tech_mentor
DATABASE_URL=sqlite+aiosqlite:///./tech_mentor.db
APP_ENV=development

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required to save an API key through PUT /api/settings/openrouter-key.
FERNET_KEY=
# Optional secret injection; never commit a real value. Stored DB credentials take precedence.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30
MODELS_CACHE_TTL_SECONDS=300
CREDITS_POLL_INTERVAL_SECONDS=300
MINIMUM_CREDITS_POLL_INTERVAL_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
